#!/bin/bash

# The omarchy package owns /usr/share/plymouth/themes/omarchy, so any update
# that ships those files puts the stock splash back over ours. Put it back --
# but only when it was actually reverted, because re-applying rebuilds the
# initramfs and that is not worth doing on every update.
#
# The splash follows whichever of our themes is current, so the mark on the
# boot screen and the disk unlock prompt is the one the desktop wears. A
# theme switch does not apply it by itself: that needs sudo and an initramfs
# rebuild, so it waits for `encom-splash` or the next update.
#
# Never fails the update: a boot splash is not worth aborting an upgrade over.

# Ours are the themes carrying a palette; anything else falls back to the
# base theme rather than being listed by name here.
current=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
theme_dir=$(omarchy-theme-dir "$current" 2>/dev/null)
if [[ -n $current && -f $theme_dir/encom.json ]]; then
  theme=$current
else
  theme=tron-legacy
  theme_dir=$(omarchy-theme-dir "$theme" 2>/dev/null) || exit 0
fi
logo=$theme_dir/unlock.png
[[ -f $logo ]] || exit 0

if cmp -s "$logo" /usr/share/plymouth/themes/omarchy/logo.png; then
  exit 0
fi

echo -e "\e[36mSetting the $theme boot splash...\e[0m"
omarchy plymouth set-by-theme "$theme" ||
  echo -e "\e[33mCould not set the boot splash; run: omarchy plymouth set-by-theme $theme\e[0m" >&2
exit 0
